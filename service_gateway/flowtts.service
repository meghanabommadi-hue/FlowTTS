[Unit]
Description=FlowTTS TTS Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/FlowTTS
Environment="PATH=/home/ubuntu/FlowTTS/llm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONPATH=/home/ubuntu/FlowTTS"
Environment="LD_LIBRARY_PATH=/home/ubuntu/FlowTTS/llm/lib/python3.12/site-packages/torch/lib:/home/ubuntu/FlowTTS/llm/lib/python3.12/site-packages/nvidia/cudnn/lib:/home/ubuntu/FlowTTS/llm/lib/python3.12/site-packages/nvidia/cu13/lib:/home/ubuntu/FlowTTS/llm/lib/python3.12/site-packages/tensorrt_libs"
ExecStart=/home/ubuntu/FlowTTS/llm/bin/python3 -m flowtts.server \
    --base-port 8765 \
    --ports 1 \
    --ctrl-port 8764
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
