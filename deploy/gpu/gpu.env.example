# /opt/chaashini/gpu.env on the GPU box
CHAASHINI_API_URL=http://101.53.139.186        # CPU box, port 80 (nginx), selected by Host header below
CHAASHINI_API_HOST=chaashini-internal
CHAASHINI_INTERNAL_TOKEN=change-me              # same value as api.internal_token on the CPU box
CHAASHINI_MODELS_DIR=/opt/chaashini/models
CHAASHINI_LOG_DIR=/opt/chaashini/logs
CHAASHINI_ASR_BATCH=16
CHAASHINI_ASR_LOOKAHEAD=13
CHAASHINI_ENHANCE_RUN_DIR=/opt/chaashini/models/resemble-enhance/enhancer_stage2
CHAASHINI_GPU_NAME=gpu-asr
CHAASHINI_GPU_ENH_NAME=gpu-enhance
CHAASHINI_GPU_MEM_FRACTION=0.25       # ASR+diarization worker share of GPU memory (shared GPU!)
CHAASHINI_GPU_ENH_MEM_FRACTION=0.17   # enhancer share
CHAASHINI_ENH_CHUNK_S=8               # enhancer inference window (s); smaller = less VRAM
