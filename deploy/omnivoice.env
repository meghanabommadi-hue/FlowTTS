# FlowTTS / OmniVoice service configuration.
# Read by start.sh and by any CLI you run by hand:  set -a; . omnivoice.env; set +a

# --- Environment -----------------------------------------------------------
HF_HOME=/home/jovyan/.cache/huggingface
PYTHONPATH=/root/omnivoice-svc
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# The tokenizers fast-path forks; silence its warning under uvicorn's workers.
TOKENIZERS_PARALLELISM=false

# --- Model -----------------------------------------------------------------
# The weights already in the shared HF cache. Nothing is re-downloaded.
FLOWTTS_OMNIVOICE__MODEL_PATH=/home/jovyan/.cache/huggingface/hub/models--k2-fsa--OmniVoice/snapshots/current
FLOWTTS_OMNIVOICE__DEVICE=cuda:0
FLOWTTS_OMNIVOICE__DTYPE=float16

# --- Backbone acceleration -------------------------------------------------
# auto = use a built TensorRT engine if one exists, else TRT-LLM, else compiled
# torch, else stock PyTorch. Every option is validated against the real module
# before it is installed, so "auto" can never silently degrade the audio.
FLOWTTS_OMNIVOICE__BACKBONE_BACKEND=auto
FLOWTTS_OMNIVOICE__TRT_ENGINE_DIR=/root/omnivoice-svc/engines/omnivoice-backbone
FLOWTTS_OMNIVOICE__TRTLLM_ENGINE_DIR=/root/omnivoice-svc/engines/omnivoice-trtllm
FLOWTTS_OMNIVOICE__BACKBONE_VALIDATE=true

# --- Batching --------------------------------------------------------------
# The GPU is shared with a long-running transliteration training job; these keep
# our footprint clear of it while still coalescing aggressively.
FLOWTTS_OMNIVOICE__MAX_BATCH=24
FLOWTTS_OMNIVOICE__BATCH_TIMEOUT_MS=8
FLOWTTS_OMNIVOICE__MAX_BATCH_FRAMES=6000
FLOWTTS_OMNIVOICE__MAX_ACTIVE_REQUESTS=256

# --- Voices ----------------------------------------------------------------
FLOWTTS_VOICES__VOICES_DIR=/root/omnivoice-svc/voices
FLOWTTS_VOICES__DEFAULT_VOICE=anika
FLOWTTS_VOICES__MAX_REFERENCE_SECONDS=20

# --- Cache -----------------------------------------------------------------
FLOWTTS_WAV_CACHE_DIR=/root/omnivoice-svc/cache
FLOWTTS_WAV_CACHE_ENABLED=true

# --- Listeners -------------------------------------------------------------
FLOWTTS_SERVER__HTTP_PORT=9000
FLOWTTS_SERVER__CTRL_PORT=9764
FLOWTTS_SERVER__WS_BASE_PORT=9080
FLOWTTS_SERVER__WS_PORTS=2
