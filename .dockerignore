# Keep the build context small & the image clean.
.git
.gitignore
.venv
venv
llmc
**/__pycache__
*.py[cod]
*.pyo

# large / runtime artifacts not needed in the image
sample_audio/
voices/*.npz
cached_data*/
model_dir/          # local model weights — bind-mounted at runtime, not baked in
monitoring/requests/
monitoring/prometheus-data/
monitoring/*.jsonl
monitoring/*.json
llm.log
test/
**/pipeline_test_*/
**/bench_*/

# docs / editor / agent scratch
.claude
.idea
.vscode
*.md
!README.md
